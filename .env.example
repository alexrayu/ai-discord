DISCORD_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low         # low | medium | high | xhigh | max
OPENAI_API_KEY=
GPT_MODEL=                # OpenAI model ID for Quill
GPT_REASONING_EFFORT=     # optional; sent as reasoning_effort for reasoning models, e.g. low
OWNER_USER_ID=            # optional; user who can run bot commands. Empty: the server owner
ALLOWED_CHANNEL_IDS=      # comma-separated; bot ignores all other channels
MAX_REPLY_TOKENS=4000     # hard ceiling incl. reasoning tokens; brevity comes from the prompt
TRANSCRIPT_CHAR_LIMIT=60000
USER_ROUNDS_PER_HOUR=20   # per-member cap; the owner is exempt
DEBUG=false
