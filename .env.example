DISCORD_TOKEN=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_EFFORT=medium      # low | medium | high | xhigh | max
OPENAI_API_KEY=
GPT_MODEL=                # OpenAI model ID for Quill
GPT_REASONING_EFFORT=     # optional; sent as reasoning_effort for reasoning models, e.g. low
OWNER_USER_ID=            # optional; user who can run bot commands. Empty: the server owner
ALLOWED_CHANNEL_IDS=      # comma-separated review channels; bot ignores all others
MAX_REPLY_TOKENS=16000    # per step, incl. reasoning tokens
IMAGE_MAX_EDGE=1568       # images are downscaled to fit inside N x N px
USER_REVIEWS_PER_HOUR=5   # per-member cap; the owner is exempt
FOLLOWUPS_PER_HOUR=30     # per-member cap on questions in review threads; the owner is exempt
DEBUG=false
